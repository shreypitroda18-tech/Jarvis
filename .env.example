# ==============================================================================
# JARVIS Environment Configuration Example
# Copy this file to .env and configure your credentials.
# ==============================================================================

# Primary and Fallback LLM Provider Configuration
# Supported providers: groq, ollama, gemini
LLM_PROVIDER=groq
LLM_FALLBACKS=ollama

# Groq Cloud Configuration (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Local Configuration (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2:3b

# Optional: Google Gemini Configuration (https://aistudio.google.com)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
